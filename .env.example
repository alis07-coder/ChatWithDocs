# ChatWithDocs environment variables
#
# 1. Copy this file to `.env` in the same folder (the repository root).
# 2. Fill in the values you need for the phase you're working on.
# `.env` is git-ignored, so your keys are never committed.
#
# Keys are only checked when a feature uses them, so you can leave
# later phases blank until you get there.

# --- Neon: remote Postgres database with pgvector (needed from Phase 1) ---
# Neon console → your project → Connect → copy the connection string.
# Keep `?sslmode=require` at the end.
DATABASE_URL=

# --- Voyage AI: embeddings (needed from Phase 2) ---
# https://dashboard.voyageai.com → API keys
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Anthropic: Claude for the chatbot (needed from Phase 6) ---
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- MCP server (needed from Phase 5) ---
MCP_SERVER_PORT=3001
MCP_SERVER_URL=http://localhost:3001/mcp
